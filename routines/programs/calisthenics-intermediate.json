          "muscleGroup": "Core",
          "sets": {
            "count": 3,
            "reps": 12,
            "restSeconds": 45
          }
        },
        {
          "name": "Plank",
          "muscleGroup": "Core",
          "sets": {
            "count": 3,
            "seconds": 60,
            "restSeconds": 45
          }
        }
      ]
    }
  ]
}
