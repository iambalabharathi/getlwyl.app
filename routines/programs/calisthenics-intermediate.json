          "muscleGroup": "Back",
          "sets": {
            "count": 3,
            "reps": 6,
            "restSeconds": 120
          }
        },
        {
          "name": "Diamond Push Ups",
          "muscleGroup": "Chest",
          "sets": {
            "count": 3,
            "reps": 10,
            "restSeconds": 75
          }
        },
        {
          "name": "Hanging Leg Raise",
          "muscleGroup": "Core",
          "sets": {
            "count": 3,
            "reps": 8,
            "restSeconds": 60
          }
