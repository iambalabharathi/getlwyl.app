{
  "id": "core-advanced",
  "title": "Advanced Core",
  "summary": "Demanding core training for experienced trainees with a pull-up bar. Three sessions a week cover anti-extension, rotation and hanging strength with moves such as dragon flags, toes-to-bar and L-sits.",
  "goal": "general",
  "level": "advanced",
  "equipment": [
    "bodyweight",
    "pull-up-bar"
  ],
  "weeks": 6,
  "pattern": [
    {
      "weekday": 1,
      "routine": "Front Line"
    },
    {
      "weekday": 3,
      "routine": "Rotation & Lateral"
    },
    {
      "weekday": 5,
      "routine": "Hanging Core"
    }
  ],
  "unit": "kg",
  "templates": [
